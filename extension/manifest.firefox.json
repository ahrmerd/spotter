{
  "manifest_version": 3,
  "name": "Spotter",
  "version": "0.3.1",
  "description": "Detects videos on the page and sends them to the local download manager.",
  "permissions": [
    "webRequest",
    "cookies",
    "contextMenus",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:6800/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Detected videos"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "video-downloader@local"
    }
  }
}